{
	"name": "da41b94c/dijkstras-algorithm-php",
	"description": "Educational implementation of Dijkstra's shortest-path algorithm for PHP.",
	"type": "library",
	"license": "MIT",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"autoload": {
		"psr-4": {
			"Da41b94c\\Dijkstra\\": "src/"
		},
		"files": [
			"dijkstra.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Da41b94c\\Dijkstra\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true
	}
}
